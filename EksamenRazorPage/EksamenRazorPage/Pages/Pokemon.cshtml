@page
@model EksamenRazorPage.Pages.PokemonModel
@{
    ViewData["Title"] = "Pokemon";
}

<h1>Pokemons</h1>


<table class="table table-dark table-hover" id="PokemonTable">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Type</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pokemon in Model.PokemonList)
        {
            // Make rows clickable by having an onclick refer to where to take us with the click.
            <tr class="position-relative">
                <td>@pokemon.Id</td>
                <td>@pokemon.Name</td>
                <td>@pokemon.Type1<br />@pokemon.Type2</td>
                <td>
                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/@(pokemon.Id).png" alt="@pokemon.Name" />
                </td>
                <td><a asp-page="/View" asp-route-Id="@pokemon.Id" class="stretched-link"></a></td>
            </tr>
        }
    </tbody>
</table>
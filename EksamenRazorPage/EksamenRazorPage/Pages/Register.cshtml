@page
@model Login.Pages.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>

    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="~/css/register.css" />
</head>

<body>
    <div class="login-container">

        <a asp-page="/Index" class="back-home">← Back to Home</a>

        <form method="post" class="login-card">

            <h1 class="title">Create Account</h1>
            <p class="subtitle">Sign up to get started</p>

            <div class="input-group">
                <input asp-for="Username" type="text" required />
                <label>Username</label>
            </div>

            <div class="input-group">
                <input asp-for="DisplayName" type="text" required />
                <label>Display Name</label>
            </div>

            <div class="input-group">
                <input asp-for="Email" type="email" required />
                <label>Email</label>
            </div>

            <div class="input-group">
                <input asp-for="Password" type="password" required />
                <label>Password</label>
            </div>

            <div class="input-group">
                <input asp-for="ConfirmPassword" type="password" required />
                <label>Confirm Password</label>
                <span class="validation" asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="button">
                Register
            </button>

            <div class="register">
                <p>
                    Already have an account?
                    <a asp-page="/Login">Login</a>
                </p>
            </div>

        </form>
    </div>
</body>

</html>

<!-- Validation scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
@page "/Pokemon/View/{id}"
@model EksamenRazorPage.Pages.ViewModel
@{
    ViewData["Title"] = "View";
}

<link rel="stylesheet" href="~/css/view.css"/>

<h1>@Model.SelectedPokemon.Name</h1>

<div class="row">
    <div class="col-4">
        <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/@(Model.SelectedPokemon.Id).png"
             alt="@Model.SelectedPokemon.Name" />
    </div>
    <div class="col-8">
        <table class="d-block w-100">
            <tbody>
                <!-- One tr is one row with name, stat number and a barto showcase. -->
                <!-- HP Stat -->
                <tr>
                    <th>HP</th>
                    <td>@Model.SelectedPokemon.HP</td>
                    <td>
                        <progress class="progressbar" max="180" value="@Model.SelectedPokemon.HP"></progress>
                    </td>
                </tr>
                <!-- Attack Stat -->
                <tr>
                    <th>Attack</th>
                    <td>@Model.SelectedPokemon.Attack</td>
                    <td>
                        <progress class="progressbar" max="180" value="@Model.SelectedPokemon.Attack"></progress>
                    </td>
                </tr>
                <!-- Defense Stat -->
                <tr>
                    <th>Defense</th>
                    <td>@Model.SelectedPokemon.Defense</td>
                    <td>
                        <progress class="progressbar" max="180" value="@Model.SelectedPokemon.Defense"></progress>
                    </td>
                </tr>
                <!-- Sp. Attack -->
                <tr>
                    <th>Sp. Attack</th>
                    <td>@Model.SelectedPokemon.SpAtk</td>
                    <td>
                        <progress class="progressbar" max="180" value="@Model.SelectedPokemon.SpAtk"></progress>
                    </td>
                </tr>
                <!-- Sp. Defense -->
                <tr>
                    <th>Sp. Defense</th>
                    <td>@Model.SelectedPokemon.SpDef</td>
                    <td>
                        <progress class="progressbar" max="180" value="@Model.SelectedPokemon.SpDef"></progress>
                    </td>
                </tr>
                <!-- Speed -->
                <tr>
                    <th>Speed</th>
                    <td>@Model.SelectedPokemon.Speed</td>
                    <td>
                        <progress class="progressbar" max="180" value="@Model.SelectedPokemon.Speed"></progress>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="col-8">
        <h2>Moves</h2>
        <div class="col justify-content-center">
            <table class="table table-dark table-hover mb-0" id="movesTable">
                <thead>
                    <tr>
                        <th>Navn</th>
                        <th>Type</th>
                        <th>Kategori</th>
                        <th>Power</th>
                        <th>PP</th>
                        <th>Effekt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var move in Model.SelectedPokemon.Movepool)
                    {
                        <tr>
                            <td>@move.Name</td>
                            <td>@move.Type</td>
                            <td>@move.Category</td>
                            <td>@move.Power</td>
                            <td>@move.PowerPoints</td>
                            <td>@move.Effect</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
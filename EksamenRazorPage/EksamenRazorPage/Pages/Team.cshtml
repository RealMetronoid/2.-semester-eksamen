@page
@model EksamenRazorPage.Pages.TeamModel
@{
    ViewData["Title"] = "My Teams";
}

<h2 class="text-white mb-4">My Teams</h2>    

<!-- Create Team -->
<div class="card mb-4">
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="d-flex gap-2">
            <input type="text" name="teamName" class="form-control" placeholder="Team name..." required>
            <button type="submit" class="btn btn-danger">Create Team</button>
        </form>
    </div>
</div>

@if (!Model.Teams.Any())
{
    <p class="text-muted">You don't have any teams yet.</p>
}

@foreach (var team in Model.Teams)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@team.Name</strong>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" name="teamId" value="@team.Id">
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('Delete team?')">
                    Delete Team
                </button>
            </form>
        </div>
        <div class="card-body">

            <!-- 6 slots -->
            <div class="row g-2 mb-3">
                @for (int slot = 1; slot <= 6; slot++)
                {
                    var member = team.Members.FirstOrDefault(m => m.Slot == slot);
                    var pokemon = member != null
                    ? Model.AllPokemon.FirstOrDefault(p => p.Id == member.PokemonId)
                    : null;

                    <div class="col-6 col-md-2">
                        <div class="card text-center h-100"
                             style="border: 2px @(pokemon != null ? "solid #b71c1c" : "dashed #555")">
                            <div class="card-body p-2">
                                @if (pokemon != null)
                                {
                                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/@(pokemon.Id).png"
                                         style="width:64px;height:64px;image-rendering:pixelated;">
                                    <div class="fw-bold small">@pokemon.Name</div>
                                    <form method="post" asp-page-handler="RemoveMember" class="mt-1">
                                        <input type="hidden" name="memberId" value="@member.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">✕ Remove</button>
                                    </form>
                                }
                                else
                                {
                                    <div style="font-size:2rem;color:#555;">+</div>
                                    <small class="text-muted">Slot @slot</small>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Add Pokemon -->
            @if (team.Members.Count < 6)
            {
                <form method="post" asp-page-handler="AddMember" class="d-flex gap-2">
                    <input type="hidden" name="teamId" value="@team.Id">
                    <select name="pokemonId" class="form-control">
                        <option value="0">Select a Pokemon...</option>
                        @foreach (var p in Model.AllPokemon)
                        {
                            <option value="@p.Id">#@p.Id.ToString("D3") @p.Name</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-danger">Add</button>
                </form>
            }
            else
            {
                <small class="text-muted">Team is full (6/6)</small>
            }

        </div>
    </div>
}
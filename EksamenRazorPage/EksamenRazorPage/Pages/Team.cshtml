@page
@model EksamenRazorPage.Pages.TeamModel
@{
    ViewData["Title"] = "Mine Hold";
}

<h2 class="text-white mb-4">Mine Hold</h2>

@if (Model.IsLoggedIn)
{
    <!-- Opret nyt hold -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="text-white mb-3">Opret nyt hold</h5>
            <form method="post" asp-page-handler="Create" class="d-flex gap-2">
                <input type="text" name="teamName" class="form-control"
                       placeholder="Holdnavn..." required>
                <button type="submit" class="btn btn-danger">Opret</button>
            </form>
        </div>
    </div>

    <!-- Liste over hold -->
    @if (!Model.Teams.Any())
    {
        <p class="text-muted">Du har ingen hold endnu. Opret et ovenfor.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var team in Model.Teams)
            {
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <h5 class="text-white mb-0">@team.Name</h5>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="teamId" value="@team.Id">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Slet</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <p class="text-muted">
        Du skal være logget ind for at se dine hold.
        <a asp-page="/LogIn" class="text-danger">Log ind her</a>
    </p>
}